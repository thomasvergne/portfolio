---
import Button from "#/components/Button.astro";
import Footer from "#/components/Footer.astro";
import Navigation from "#/components/Navigation.astro";
import { getLangFromUrl, useTranslations } from "#/i18n/utils";
import Layout from "#/layouts/Layout.astro";

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error") as
  | "missingData"
  | "invalidEmail"
  | undefined;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={success ? t("contact.success.title") : t("contact.error.title")}
  {lang}
  description={success
    ? t("contact.success.description")
    : t("contact.error.description")}
  class="bg-background flex flex-col h-full"
>
  <Navigation {lang} />

  <div
    class="max-w-4xl mx-auto w-full py-32 text-center border-x-[10px] border-text flex-auto"
  >
    <h2
      class="text-6xl max-w-2xl mx-auto leading-12 text-white text-extrusion font-title lowercase"
    >
      {success ? t("contact.success.title") : t("contact.error.title")}
    </h2>

    <p class="text-2xl my-16 text-text/70 max-w-2xl mx-auto font-serif">
      {
        success
          ? t("contact.success.description")
          : t("contact.error.description")
      }
    </p>

    {
      error === "missingData" && (
        <p class="text-2xl my-16 text-sundown-500 max-w-2xl mx-auto font-serif">
          {t("contact.error.missingData.description")}
        </p>
      )
    }
    {
      error === "invalidEmail" && (
        <p class="text-2xl my-16 text-sundown-500 max-w-2xl mx-auto font-serif">
          {t("contact.error.invalidEmail.description")}
        </p>
      )
    }

    <Button href={`/${lang}/#contact`} kind="white" class="mt-8 w-max mx-auto">
      {t("contact.back")}
    </Button>
  </div>

  <Footer {lang} class="border-t-[10px] border-text" />
</Layout>
