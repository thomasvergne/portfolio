---
import type { Languages } from "#/i18n/ui";
import { useTranslations } from "#/i18n/utils";
import type { HTMLAttributes } from "astro/types";
import Button from "./Button.astro";
import { cn } from "./css";

interface Props extends HTMLAttributes<"footer"> {
    lang: Languages;
}

const { lang, class: className, ...props } = Astro.props;

const t = useTranslations(lang);

const socialLinks = [
    {
        name: "github.com/thomasvergne",
        url: "https://github.com/thomasvergne",
    },
    {
        name: "in/thomasvergne",
        url: "https://linkedin.com/in/thomasvrgn",
    },
    {
        name: "discord.com/thomasvergne",
        url: "https://discordapp.com/users/766231131720646666",
    },
    {
        name: "contact@thomas-vergne.fr",
        url: "mailto:contact@thomas-vergne.fr",
    },
];
---

<footer
    class={cn(
        "py-32 max-md:py-16 bg-peach-orange-300 relative z-10 border-b-[10px] border-text",
        className,
    )}
    id="contact"
    {...props}
>
    <div class="sm:max-w-6xl md:mx-auto sm:px-8">
        <h2
            class="text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-black font-title text-extrusion text-white lowercase px-4"
        >
            {t("contact.title.firstPart")}
            <br />
            <span
                class="font-serif text-[3.5rem] md:text-[5rem] lg:text-[6.25rem] xl:text-[7.75rem]"
            >
                {t("contact.title.secondPart")}
            </span>
        </h2>

        <div class="grid md:grid-cols-3 gap-8 px-4">
            <form
                class="mt-16 space-y-8 md:col-span-2"
                action="/api/mail"
                method="POST"
            >
                <input type="text" name="lang" value={lang} hidden />

                <div class="grid md:grid-cols-2 gap-8">
                    <fieldset>
                        <label
                            for="name"
                            class="block text-xl font-semibold text-text font-title lowercase"
                        >
                            {t("contact.form.name")}
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="mt-2 p-4 w-full border-[5px] border-text bg-white text-text focus:outline-text outline-offset-2 focus:outline-[5px] font-title"
                            required
                        />
                    </fieldset>
                    <fieldset>
                        <label
                            for="email"
                            class="block text-xl font-semibold text-text font-title lowercase"
                        >
                            {t("contact.form.email")}
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="mt-2 p-4 w-full border-[5px] border-text bg-white text-text focus:outline-text outline-offset-2 focus:outline-[5px] font-title"
                            required
                        />
                    </fieldset>
                </div>
                <fieldset>
                    <label
                        for="subject"
                        class="block text-xl font-semibold text-text font-title lowercase"
                    >
                        {t("contact.form.subject")}
                    </label>
                    <input
                        type="text"
                        id="subject"
                        name="subject"
                        class="mt-2 p-4 w-full border-[5px] border-text bg-white text-text focus:outline-text outline-offset-2 focus:outline-[5px] font-title"
                        required
                    />
                </fieldset>
                <fieldset>
                    <label
                        for="message"
                        class="block text-xl font-semibold text-text font-title lowercase"
                    >
                        {t("contact.form.message")}
                    </label>
                    <textarea
                        rows="5"
                        id="message"
                        name="message"
                        class="mt-2 p-4 w-full border-[5px] border-text bg-white text-text focus:outline-text outline-offset-2 focus:outline-[5px] font-title"
                        required></textarea>
                </fieldset>

                <Button kind="white" class="max-sm:w-full w-max">
                    {t("contact.form.send")}
                </Button>
            </form>

            <div class="mt-16 space-y-8 col-span-1">
                <h3
                    class="text-2xl font-semibold text-text font-title lowercase"
                >
                    {t("contact.socials")}
                </h3>
                <ul class="space-y-4">
                    {
                        socialLinks.map((link) => (
                            <li>
                                <a
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-xl text-text hover:text-extrusion hover:text-white transition-all duration-150 font-title"
                                >
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</footer>
