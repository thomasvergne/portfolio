---
import type { HTMLAttributes } from "astro/types";
import { cn } from "#/components/css";

interface Props extends HTMLAttributes<"div"> {
  speed?: number;
  direction?: "forwards" | "reverse";
  position?: "y" | "x";
  gap?: number;
  "should-not-stop-on-hover"?: boolean;
}

const {
  speed = 10,
  direction = "forwards",
  position = "x",
  class: className,
  gap = 16,
  "should-not-stop-on-hover": shouldNotStopOnHover = false,
  ...props
} = Astro.props;
---

<script>
  const elements = document.querySelectorAll(".marquee");

  elements.forEach((element) => {
    const div = element as HTMLDivElement;

    const firstHiddenItem = div.querySelector(
      "#first-hidden-item"
    ) as HTMLElement;

    div.style.setProperty("--width", `${firstHiddenItem.offsetLeft}px`);
  });
</script>

<div
  class="marquee"
  style={{
    "--speed": `${speed}s`,
    "--direction": direction,
    "--gap": `${gap}px`,
    "--should-not-stop-on-hover": shouldNotStopOnHover ? "running" : "paused",
  }}
>
  <div
    {...props}
    style={{
      gap: gap + "px",
    }}
    class={cn("flex pl-8 w-max marquee-track", className)}
  >
    <slot />
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee-move var(--speed) linear infinite
      var(--direction, forwards);
  }

  .marquee-track:hover {
    animation-play-state: var(--should-not-stop-on-hover);
  }

  @keyframes marquee-move {
    to {
      transform: translateX(calc((var(--width) - var(--gap)) * -1));
    }
  }
</style>
